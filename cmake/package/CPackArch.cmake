#File Name:
#**  CPackArch.cmake
#
#File Description:
#**  CPack External generator script: one Arch Linux (pacman)
#**  package (.pkg.tar.zst) per component of the staging tree
#**  (same components, names and channels as the RPM / DEB)
#**************************************************************#

find_program(ARCH_BSDTAR bsdtar)
if(NOT ARCH_BSDTAR)
    message(FATAL_ERROR "bsdtar (libarchive) is required to build the Arch packages")
endif()

string(TIMESTAMP ARCH_BUILD_DATE "%s" UTC)
set(ARCH_PKGVER "${CPACK_PACKAGE_VERSION}")
set(ARCH_PKGREL "${CPACK_ARCH_PACKAGE_RELEASE}")

# Write a list as "<key> = <value>" lines of the .PKGINFO
function(arch_pkginfo_list out key)
    set(lines "")
    foreach(value IN LISTS ARGN)
        string(APPEND lines "${key} = ${value}\n")
    endforeach()
    set(${out} "${lines}" PARENT_SCOPE)
endfunction()

# Value of CPACK_ARCH_<COMPONENT>_<NAME>, else of CPACK_ARCH_PACKAGE_<NAME>
function(arch_component_value out component name)
    string(TOUPPER "${component}" upper)
    if(DEFINED CPACK_ARCH_${upper}_PACKAGE_${name})
        set(${out} "${CPACK_ARCH_${upper}_PACKAGE_${name}}" PARENT_SCOPE)
    else()
        set(${out} "${CPACK_ARCH_PACKAGE_${name}}" PARENT_SCOPE)
    endif()
endfunction()

# One package per staged component (the meta package has no component: empty tree)
set(ARCH_COMPONENTS ${CPACK_COMPONENTS_ALL})
if(NOT ARCH_COMPONENTS)
    set(ARCH_COMPONENTS "meta")
    file(MAKE_DIRECTORY "${CPACK_TEMPORARY_DIRECTORY}/meta")
endif()

set(ARCH_BUILT_PACKAGES "")
foreach(component IN LISTS ARCH_COMPONENTS)
    set(root "${CPACK_TEMPORARY_DIRECTORY}/${component}")
    if(NOT EXISTS "${root}")
        file(MAKE_DIRECTORY "${root}")
    endif()

    # Arch layout: the libraries in /usr/lib (not lib64), the CMake files follow
    if(EXISTS "${root}/usr/lib64")
        file(COPY "${root}/usr/lib64/" DESTINATION "${root}/usr/lib")
        file(REMOVE_RECURSE "${root}/usr/lib64")
        file(GLOB_RECURSE cmake_files "${root}/usr/lib/cmake/*.cmake")
        foreach(cmake_file IN LISTS cmake_files)
            file(READ "${cmake_file}" content)
            string(REPLACE "/lib64/" "/lib/" content "${content}")
            file(WRITE "${cmake_file}" "${content}")
        endforeach()
    endif()

    arch_component_value(name ${component} NAME)
    arch_component_value(arch ${component} ARCHITECTURE)
    arch_component_value(desc ${component} DESCRIPTION)
    arch_component_value(depends ${component} DEPENDS)
    arch_component_value(optdepends ${component} OPTDEPENDS)
    arch_component_value(conflicts ${component} CONFLICTS)
    arch_component_value(replaces ${component} REPLACES)

    # Installed size (bytes)
    set(size 0)
    file(GLOB_RECURSE files LIST_DIRECTORIES false "${root}/*")
    foreach(file IN LISTS files)
        file(SIZE "${file}" file_size)
        math(EXPR size "${size} + ${file_size}")
    endforeach()

    arch_pkginfo_list(license_lines license ${CPACK_ARCH_PACKAGE_LICENSE})
    arch_pkginfo_list(depend_lines depend ${depends})
    arch_pkginfo_list(optdepend_lines optdepend ${optdepends})
    arch_pkginfo_list(conflict_lines conflict ${conflicts})
    arch_pkginfo_list(replaces_lines replaces ${replaces})
    file(WRITE "${root}/.PKGINFO"
        "# Generated by CPack (cmake/package/CPackArch.cmake)\n"
        "pkgname = ${name}\n"
        "pkgbase = ${name}\n"
        "pkgver = ${ARCH_PKGVER}-${ARCH_PKGREL}\n"
        "pkgdesc = ${desc}\n"
        "url = ${CPACK_ARCH_PACKAGE_URL}\n"
        "builddate = ${ARCH_BUILD_DATE}\n"
        "packager = ${CPACK_ARCH_PACKAGE_PACKAGER}\n"
        "size = ${size}\n"
        "arch = ${arch}\n"
        "${license_lines}${replaces_lines}${conflict_lines}${depend_lines}${optdepend_lines}"
    )

    # Content: .PKGINFO first, .MTREE, then the tree, owned by root
    file(GLOB entries RELATIVE "${root}" "${root}/*")
    list(REMOVE_ITEM entries ".PKGINFO" ".MTREE")
    set(owner --uid 0 --gid 0 --uname root --gname root)
    execute_process(
        COMMAND ${ARCH_BSDTAR} -czf .MTREE --format=mtree ${owner}
            --options=!all,use-set,type,uid,gid,mode,time,size,md5,sha256,link .PKGINFO ${entries}
        WORKING_DIRECTORY "${root}"
        RESULT_VARIABLE result
    )
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Arch package ${name}: .MTREE creation failed")
    endif()

    set(package "${CPACK_TOPLEVEL_DIRECTORY}/${name}-${ARCH_PKGVER}-${ARCH_PKGREL}-${arch}.pkg.tar.zst")
    execute_process(
        COMMAND ${ARCH_BSDTAR} --zstd -cf "${package}" ${owner} .PKGINFO .MTREE ${entries}
        WORKING_DIRECTORY "${root}"
        RESULT_VARIABLE result
    )
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Arch package ${name}: archive creation failed")
    endif()
    list(APPEND ARCH_BUILT_PACKAGES "${package}")
endforeach()

set(CPACK_EXTERNAL_BUILT_PACKAGES ${ARCH_BUILT_PACKAGES})
